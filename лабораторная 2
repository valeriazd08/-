# Z = 1/1! - X/2! + Y^2/3! - X^3/4! + Y^4/5! - ...
import math

X = 2.0
Y = 1.5
eps = 1e-6

print(f"X = {X}, тип: {type(X)}")
print(f"Y = {Y}, тип: {type(Y)}")

Z = 0.0
n = 1
while True:
    numerator = Y ** (n - 1) if n % 2 == 1 else X ** (n - 1)
    term = numerator / math.factorial(n)
    Z += (-1) ** (n + 1) * term
    if term < eps:
        break
    n += 1

print(f"\nКоличество членов: {n}")
print(f"Z = {Z:.6f}")


