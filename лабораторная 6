with open('pr6_1.txt', 'r', encoding='utf-8') as f:
    text = f.read().strip()

count = 0
for i in range(2, len(text)):
    if text[i] == 'S' and text[i - 1].isdigit() and text[i - 2].isdigit():
        count += 1

print(f"Количество букв S, перед которыми две цифры: {count}")



